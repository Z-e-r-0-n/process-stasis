{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Process Stasis",
  "version": "0.2.0",
  "identifier": "io.process-stasis.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Process Stasis",
        "width": 1480,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "maximized": false,
        "center": true,
        "backgroundColor": "#f3f2ef"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Live Linux process intelligence",
    "longDescription": "Inspect, track, graph, record, and analyze Linux processes in real time.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["gstreamer1.0-plugins-base"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
